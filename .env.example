# Copy this file to .env and fill in real values.
# Get Supabase values from your Supabase project's Settings > API page.
# Get Google values from Google Cloud Console > APIs & Services > Credentials.

SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_ANON_KEY=""
VITE_SUPABASE_URL=""

# Server-only -- never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# Google Gemini API key, used to power Lumin AI.
GEMINI_API_KEY=""

# Google OAuth client used by the web/Android "Continue with Google" flow
# (Google Identity Services). Application type: Web application.
VITE_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Separate "iOS" application-type OAuth client, used only by the native iOS
# app's Google sign-in. Bundle ID must match ios/ios/App/App/Info.plist.
VITE_GOOGLE_IOS_CLIENT_ID=""

# Google API key used for calendar/other Google API calls (not sign-in).
VITE_GOOGLE_API_KEY=""

# Random secrets you generate yourself (e.g. `openssl rand -hex 32`).
TOKEN_ENCRYPTION_KEY=""
OAUTH_STATE_SECRET=""

# Secret used to authorize scheduled/cron API routes.
CRON_SECRET=""

# SendGrid API key, used for transactional email.
SENDGRID_API_KEY=""
