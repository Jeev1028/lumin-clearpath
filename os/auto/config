#!/bin/sh
set -e
lb config noauto \
  --distribution bookworm \
  --binary-images iso-hybrid \
  --archive-areas "main contrib non-free-firmware" \
  --apt-recommends false \
  --debian-installer none \
  --memtest none \
  --iso-volume LUMIN_OS \
  --iso-application "Lumin OS" \
  --bootappend-live "boot=live components quiet splash username=lumin hostname=lumin-os" \
  "${@}"
