{
  "manifest_version": 3,
  "name": "Lumin AI — ClearPath",
  "short_name": "Lumin AI",
  "description": "Your academically-honest study companion, right in your browser. Get guidance on Google Docs, Slides, sources, and MLA citations — without anyone doing the work for you.",
  "version": "1.0.0",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lumin AI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "identity"],
  "host_permissions": ["https://luminclearpath.ca/*", "https://*.supabase.co/*"]
}
